<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
</head>
<body>
  <main>
    <h1>{{title}}</h1>

    {{#each sections}}
      {{#if visible}}
        <section>
          <h2>{{title}}</h2>
        </section>
      {{/if}}
    {{/each}}
  </main>
</body>
</html>