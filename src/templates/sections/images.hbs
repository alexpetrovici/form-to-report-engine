<section class="image-section">
  <h2>{{title}}</h2>

  <div class="image-grid">
    {{#each images}}
      <figure class="image-card">
        <img src="{{src}}" alt="{{caption}}">

        {{#if caption}}
          <figcaption>{{caption}}</figcaption>
        {{/if}}
      </figure>
    {{/each}}
  </div>
</section>
