<section>
  <h2>{{title}}</h2>

  <table>
    <thead>
      <tr>
        {{#each columns}}
          <th>{{label}}</th>
        {{/each}}
      </tr>
    </thead>

    <tbody>
      {{#each rows}}
        <tr>
          {{#each cells}}
            <td>{{value}}</td>
          {{/each}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</section>