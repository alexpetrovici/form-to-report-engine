{
  "name": "form-to-report-engine",
  "version": "0.1.0",
  "description": "Open-source schema-driven engine for turning structured form data into modular, professional HTML and PDF reports.",
  "main": "src/index.js",
  "scripts": {
    "test:normalizer": "node tests/normalize-report.test.js",
    "test:renderer": "node tests/render-html.test.js",
    "test:pdf": "node tests/render-pdf.test.js",
    "render:examples": "node scripts/test-renderer.js",
    "render:pdf-examples": "node scripts/render-pdf-examples.js",
    "debug:normalizer": "node scripts/test-normalizer.js",
    "test:schema": "node tests/validate-schema.test.js",
    "test:submission": "node tests/validate-submission.test.js",
    "test:build": "node tests/build-report.test.js",
    "test:api": "node tests/index.test.js",
    "test:conditions": "node tests/evaluate-condition.test.js",
    "test:format": "node tests/format-value.test.js",
    "test:display": "node tests/get-display-value.test.js",
    "test:tables": "node tests/table-formatting.test.js",
    "test": "npm run test:schema && npm run test:submission && npm run test:normalizer && npm run test:build && npm run test:renderer && npm run test:pdf && npm run test:api && npm run test:conditions && npm run test:format && npm run test:display && npm run test:tables"
  },
  "keywords": [
    "reporting",
    "pdf",
    "forms",
    "schema",
    "handlebars",
    "jsreport"
  ],
  "author": "Alexandru Petrovici",
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.8",
    "puppeteer": "^25.11.0"
  }
}
